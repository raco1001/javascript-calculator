{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2022", "DOM"],  
    "moduleResolution": "bundler",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": "./src",
    "resolveJsonModule": true,
    "paths": {
      "@entities/*": ["entities/*"],
      "@features/*": ["features/*"],
      "@shared/*": ["shared/*"]
    },
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"]
}