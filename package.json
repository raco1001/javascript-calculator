{
  "type": "module",
  "name": "javascript-calculator",
  "version": "0.1.0",
  "scripts": {
    "test": "jest --config jest.config.ts --transform ts-jest",
    "build": "npx tsc && tsc-alias && npm run copy-static",
    "copy-static": "cp src/app/index.html dist/app/index.html && cp src/app/styles.css dist/app/styles.css",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/babel__core": "^7.20.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.11"
  }
}
